# Backend gateway URL reachable from the browser.
PUBLIC_API_URL=http://localhost:8080

# Moth Milk shop ID.
PUBLIC_SHOP_ID=64d78766-2c38-4004-abdb-eaea3d2a9372

# The default uses the backend's pm_card_visa payment stub.
# Set to stripe when enabling Stripe Payment Element with a publishable key.
PUBLIC_PAYMENT_MODE=stub
# Stripe publishable key for Stripe mode (pk_test_... or pk_live_...).
PUBLIC_STRIPE_PUBLISHABLE_KEY=
