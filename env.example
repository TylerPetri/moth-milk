# Backend gateway URL reachable from the browser.
PUBLIC_API_URL=http://localhost:8080

# Explicit existing storefront shop UUID. Never copy a UUID from another shop.
# Leave empty only when the backend resolves this exact storefront host.
PUBLIC_SHOP_ID=

# Use Stripe for the deployed demo. Stub mode is an explicit local test setting only.
PUBLIC_PAYMENT_MODE=stripe
# Stripe publishable key for Stripe mode (pk_test_... or pk_live_...).
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Private server-to-server gateway URL; defaults to PUBLIC_API_URL. Required for cookie sessions.
API_ORIGIN=http://localhost:8080
