{
  "name": "moth-milk-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "cleanup:legacy": "node scripts/remove-legacy-js.ts --apply",
    "demo": "node scripts/demo.ts",
    "test:e2e:boundaries": "playwright test --config playwright.boundaries.config.ts",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts"
  },
  "devDependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.20.4",
    "sass": "^1.93.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.17.0"
  },
  "engines": {
    "node": "24.x"
  },
  "license": "UNLICENSED"
}
